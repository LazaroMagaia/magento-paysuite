<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="paysuite_webhook_event" resource="default" engine="innodb"
           comment="PaySuite processed webhook events (idempotency)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="event" nullable="false" length="64" comment="Event name"/>
        <column xsi:type="varchar" name="resource_id" nullable="false" length="64" comment="PaySuite resource id"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PAYSUITE_WEBHOOK_EVENT_EVENT_RESOURCE_ID">
            <column name="event"/>
            <column name="resource_id"/>
        </constraint>
    </table>
</schema>
