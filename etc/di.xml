<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="PaySuiteFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">PaySuite\Gateway\Model\Config::METHOD_CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">PaySuiteValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">PaySuiteValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">PaySuiteCommandPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaySuiteCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">PaySuite\Gateway\Gateway\Command\InitializeCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PaySuiteValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PaySuiteConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PaySuiteConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PaySuiteGatewayConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaySuiteGatewayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">PaySuite\Gateway\Model\Config::METHOD_CODE</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaySuiteCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">PaySuiteGatewayConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaySuiteValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">PaySuiteCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>
</config>
